          <mxGeometry x="1025" y="150" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="zeax" value="z_EAX = [ h_G ; θ_EAX ]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1025" y="250" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="heads" value="Prediction heads&#10;Q̂_i: expected tour length / gap&#10;T̂_i: expected runtime" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;rounded=1;arcSize=8;" vertex="1" parent="1">
