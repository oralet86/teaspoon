        <mxCell id="input" value="TSP instance&#10;N = 10k–100k&#10;node coordinates" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="sample" value="Spatial hashing /&#10;localized random walks" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="265" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="knn" value="k-NN graph inside samples&#10;(bounded-size proxy)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="220" height="65" as="geometry" />
        </mxCell>
