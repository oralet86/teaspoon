  <diagram id="graph-jepa-architecture" name="Graph-JEPA architecture">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Graph-JEPA instance-level configuration for LKH / EAX — proposed architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1600" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="From new.md: four stages, offline labels, and a strict wall-clock evaluation. Pink notes mark the main open risks." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="42" y="50" width="1300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="stage1" value="Stage I — Spatial coarsening" style="rounded=1;arcSize=2;fillColor=#f7f7f7;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;fontColor=#222222;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="260" height="640" as="geometry" />
        </mxCell>
        <mxCell id="stage2" value="Stage II — Graph-JEPA" style="rounded=1;arcSize=2;fillColor=#f7f7f7;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;fontColor=#222222;rounded=1;arcSize=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="325" y="95" width="300" height="640" as="geometry" />
        </mxCell>
        <mxCell id="stage3" value="Stage III — Solver necks" style="rounded=1;arcSize=2;fillColor=#f7f7f7;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;fontColor=#222222;rounded=1;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="650" y="95" width="330" height="640" as="geometry" />
        </mxCell>
        <mxCell id="stage4" value="Stage IV — Meta-router" style="rounded=1;arcSize=2;fillColor=#f7f7f7;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;fontColor=#222222;rounded=1;arcSize=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1005" y="95" width="330" height="640" as="geometry" />
        </mxCell>
        <mxCell id="stage5" value="Stage V — Execution" style="rounded=1;arcSize=2;fillColor=#f7f7f7;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;fontColor=#222222;rounded=1;arcSize=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1360" y="95" width="280" height="640" as="geometry" />
