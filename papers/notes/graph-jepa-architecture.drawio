          <mxGeometry x="60" y="475" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="risk1" value="Open risk: an o(N) sample can miss global clusters and bottlenecks. The claim that it preserves enough structure is an assumption, not a result." style="rounded=1;arcSize=6;fillColor=#fce4ec;strokeColor=#c2185b;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#7b1238;align=left;spacingLeft=8;" vertex="1" parent="1">
