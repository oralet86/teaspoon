        <mxCell id="objective" value="Select (solver*, θ*)&#10;argmin_i ( Q̂_i + λ log T̂_i )" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;rounded=1;arcSize=8;" vertex="1" parent="1">
