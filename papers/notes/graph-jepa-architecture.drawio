        </mxCell>
        <mxCell id="context" value="Visible context subgraph&#10;(masked regions held out)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="150" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="encoder" value="Graph encoder&#10;(GNN / Graph-JEPA)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="250" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="predictor" value="Latent predictor&#10;predicts masked-subgraph&#10;embeddings (stop-grad target)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="350" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hG" value="Global embedding&#10;h_G ∈ ℝ^d" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="475" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ssl" value="Self-supervised objective: masked latent prediction. This stage needs no configuration labels." style="rounded=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#5c4a00;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="585" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lkh" value="LKH neck (MLP)&#10;θ_LKH = (MOVE_TYPE, PATCHING_A,&#10;MAX_CANDIDATES, RUNS)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;rounded=1;arcSize=8;" vertex="1" parent="1">
