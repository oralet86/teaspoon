        </mxCell>
        <mxCell id="eax" value="EAX neck (MLP)&#10;θ_EAX = (N_pop, N_ch,&#10;initial sub-tour heuristic)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="290" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="necknote" value="One configuration per solver. Both necks are trained on offline tuning labels (bottom panel)." style="rounded=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#5c4a00;align=left;spacingLeft=8;" vertex="1" parent="1">
